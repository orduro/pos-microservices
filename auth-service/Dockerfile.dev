FROM golang:1.24.4-alpine

WORKDIR /app

# install air and required packages for development
RUN apk add --no-cache curl git \
  && go install github.com/air-verse/air@latest

# Add GOPATH/bin to PATH to ensure air is accessible
ENV PATH="/go/bin:${PATH}"

# 1. copy the commons package
COPY common/ common/

# 2. then the service 
COPY auth-service/ auth-service/

# change to the service directory
WORKDIR /app/auth-service

# download Go modules (now references local common/)
RUN go mod download

# expose port
EXPOSE 8082

# run with air for hot reload
CMD ["air"]
