# syntax=docker/dockerfile:1

# Build stage
FROM golang:1.24.4-alpine AS builder

# Install git and ca-certificates (needed for fetching dependencies and HTTPS)
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the binary
# CGO_ENABLED=0 creates a statically linked binary
# -ldflags="-w -s" strips debug info to reduce binary size
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o gateway \
    ./cmd/api

# Production stage
FROM scratch

# Copy ca-certificates from builder (needed for HTTPS requests)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy timezone data (optional, only if your app needs timezone info)
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copy the binary
COPY --from=builder /app/gateway /gateway

# Expose port
EXPOSE 8080

# Create non-root user (security best practice)
# Note: This creates a minimal user entry for scratch image
USER 65534:65534

# Run the binary
ENTRYPOINT ["/gateway"]
