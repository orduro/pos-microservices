SERVER_PORT=:8081
ENVIRONMENT=dev

# CORS_ALLOWED_ORIGINS: for development testing only
# dev: use "*" to allow postman, browser testing, any origin
# prod: NO CORS (only accessible via gateway server-to-server)
#
# examples: 
#   dev: * (allow all for testing)
#   prod: not used (CORS disabled)
CORS_ALLOWED_ORIGINS=*